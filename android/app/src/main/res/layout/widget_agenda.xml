<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ag_raiz" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/widget_fundo" android:padding="14dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Agenda" android:textSize="11sp" android:textStyle="bold"
        android:textAllCaps="true" android:letterSpacing="0.06" android:textColor="#5B6878" />

    <LinearLayout android:id="@+id/ag_1" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="6dp" android:baselineAligned="true">
        <TextView android:id="@+id/ag_1_data" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold"
            android:textColor="#1A3A5C" android:minWidth="44dp" />
        <TextView android:id="@+id/ag_1_txt" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#1E293B"
            android:maxLines="1" android:ellipsize="end" android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/ag_2" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="6dp" android:baselineAligned="true">
        <TextView android:id="@+id/ag_2_data" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold"
            android:textColor="#1A3A5C" android:minWidth="44dp" />
        <TextView android:id="@+id/ag_2_txt" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#1E293B"
            android:maxLines="1" android:ellipsize="end" android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/ag_3" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="6dp" android:baselineAligned="true">
        <TextView android:id="@+id/ag_3_data" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold"
            android:textColor="#1A3A5C" android:minWidth="44dp" />
        <TextView android:id="@+id/ag_3_txt" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#1E293B"
            android:maxLines="1" android:ellipsize="end" android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/ag_4" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="6dp" android:baselineAligned="true">
        <TextView android:id="@+id/ag_4_data" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold"
            android:textColor="#1A3A5C" android:minWidth="44dp" />
        <TextView android:id="@+id/ag_4_txt" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#1E293B"
            android:maxLines="1" android:ellipsize="end" android:layout_marginStart="6dp" />
    </LinearLayout>

    <TextView android:id="@+id/ag_vazio" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:text="Abra o Smartcalendário para carregar" android:textSize="11sp"
        android:textColor="#5B6878" />

</LinearLayout>
