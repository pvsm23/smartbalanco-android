<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo do widget: mesma cor de superfície do app (neumorfismo em tons
     claros). Widget não aceita sombra dupla como o CSS, então o relevo é
     sugerido por um contorno claro. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E8ECF3" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#FFFFFF" />
</shape>
